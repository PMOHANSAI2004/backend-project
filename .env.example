# Required: Render PostgreSQL service -> Connect -> Internal Database URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set DATABASE_SSL=true only if your database endpoint requires TLS.
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://your-netlify-site.netlify.app
EMERGENCY_NUMBER=112
# Demo accounts/data are created automatically only when the database is empty.
# Set to false for a production database after arranging an admin bootstrap flow.
SEED_DEMO_DATA=true
# Optional AI provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
